% Don't add appendices to the Table of Contents
\newboolean{appendixmode}
\setboolean{appendixmode}{false}
\let\Oldaddtoc\addcontentsline
\renewcommand{\addcontentsline}[3]{
	\ifthenelse{
		\boolean{appendixmode}\and\equal{#1}{toc}
	}{}{\Oldaddtoc{#1}{#2}{#3}}
}

% Redefine appendix
\renewcommand\appendix{
	\setcounter{tocdepth}{8}
	\setcounter{chapter}{0}
	\def\thechapter{\Alph{chapter}}
	\setboolean{appendixmode}{true}
% Continue the same columns; do not waste a page before the final notes.
}

\def\@makechapterhead#1{
	\parindent \z@ \raggedright \normalfont
		\interlinepenalty\@M
	{\underline{\fontsize{16}{17}\selectfont \bfseries #1} }
	\ifnum \c@secnumdepth >\m@ne
		{\fontsize{16}{17}\selectfont\bfseries (\thechapter) \par\nobreak }
	\fi
	\startcontents[chapters]
}

\renewcommand\section{\@startsection {section}{1}{\z@}%
