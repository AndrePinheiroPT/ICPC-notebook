\newcommand{\kactlref}[1]{%
	\ifthenelse{\boolean{appendixmode}}{}{%
		\ifnum \value{section} > 0\relax
			\addcontentsline{ptc}{subsection}{\texttt{#1}\hspace{0.2em}}%
		\else
			\addcontentsline{ptc}{section}{\texttt{#1}\hspace{0.2em}}%
		\fi
	}%
	\marks\hdrmark{#1}%
}

% Like \needspace, except with flush bottoms.
\newcommand{\myneedspace}[1]{%
  \begingroup
    \setlength{\dimen@}{#1}%
    \vskip\dimen@
    \penalty 9999%
    \vskip -\dimen@
    \vskip\z@skip
  \endgroup
}

% Summary is read from header metadata, beside the existing filename.
\newcommand{\kactlalgorithm}[2]{
    \noindent\kactlref{#1}{\fontsize{9}{10}\selectfont\bfseries #1}%
    \ifthenelse{\equal{#2}{}}{}{%
        {\fontsize{7}{7.7}\selectfont\normalfont\enspace-- #2}}%
    \par\nobreak
}

\newcommand{\kactlimport}[2][]{
	\leftcaption{}\rightcaption{}
	\setboolean{hasdescription}{false}
	\setboolean{hasusage}{false}
	\setboolean{hastime}{false}
	\setboolean{hasmemory}{false}
	\setboolean{hasleftcaption}{false}
	\par\myneedspace{6\baselineskip}
	\penalty-100
	\filename@parse{#2}
	\ifthenelse{\equal{\filename@ext}{h}}{}{
		{\large #2}\par\nobreak
	}
	\immediate\write18{rm -f \@builddir/kactl.tmp}
	\immediate\write18{python3 content/tex/preprocessor.py -i "\@kactldir/#2" -o \@builddir/kactl.tmp #1}
	\immediate\input{\@builddir/kactl.tmp}
}

