% TextMate emits only invisible presentation escapes, never changes source.
\def\VSColor{000000}
\newcommand{\VS}[1]{\gdef\VSColor{#1}}
\newcommand{\VSGuide}[1]{%
 \rlap{\hspace*{#1\fontdimen2\font}%
  {\color{codeGuide}\raisebox{-2.5pt}[0pt][0pt]{\rule{0.3pt}{8pt}}}}%
}
\def\VSGuides{}
\newcommand{\VSLine}[2]{%
 \gdef\VSGuides{#2}%
 % Preserve the source indent when a line wraps in a narrow column.
 \begingroup
  \dimen@=#1\fontdimen2\font
  \@tempdima=\linewidth \advance\@tempdima-\dimen@
  \advance\dimen@\@totalleftmargin
  \xdef\lst@breakcurrindent{\the\dimen@}%
  \xdef\lst@breakshape{\noexpand\lst@breakcurrindent\space\the\@tempdima}%
 \endgroup
 \lst@parshape\VSGuides
}
\lstset{postbreak=\VSGuides}
\lst@Key{vscode}{false}[t]{\lstKV@SetIf{#1}\lst@ifvscode}
\lst@AddToHook{Output}{\lst@ifvscode\def\lst@thestyle{\color[HTML]{\VSColor}}\fi}
\lst@AddToHook{OutputOther}{\lst@ifvscode\def\lst@thestyle{\color[HTML]{\VSColor}}\fi}
\lst@AddToHook{Init}{\gdef\VSColor{000000}\gdef\VSGuides{}}

